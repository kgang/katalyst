# Copy this file to `.env` and fill in only what you need:
#
#   cp .env.example .env
#
# `.env` is never committed. `docker compose` reads it from this directory by
# itself, and passes the values through to the container that needs them.
#
# Everything runs without either key. The app starts, the first screen loads,
# and every test passes, because the tests replay answers recorded earlier
# rather than calling anything. `/api/readyz` says which keys are present
# without ever showing one.

# The key for the language model that proposes claims and the arrows between
# them. First needed in stack 04, the one that turns a sentence into a map.
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# The key for Federal Reserve Economic Data, a free public source of economic
# time series such as oil prices and interest rates. First needed in stack 05,
# where a claim can be tied to a published series. Get one at
# https://fredaccount.stlouisfed.org/apikeys.
FRED_API_KEY=

# Where every paid run is written, whatever becomes of it: its transcript, its
# receipt, its map and its events. Empty means `backend/.runs/`, which is not
# committed. A run is written there the moment its generation ends and again once
# the scripted intervention has been drafted, so a crash in between still leaves
# what was spent on disk.
KATALYST_RUNS=

# How long a recorded generation waits between two of its events, in seconds.
# The default is the speed a person watches at, and the pause is what makes a
# replay read as a map arriving rather than appearing. `0` means no pause at all,
# which is what the server's route tests use; the end-to-end browser run uses a
# short pace rather than none, because its whole subject is a map arriving. One
# number rather than a length and a switch beside it. It is deliberately not
# something a request can ask for — a client that could skip the pacing could
# skip the thing a recording exists to show.
KATALYST_REPLAY_PACE=0.6

# Which model proposes the claims and the arrows. One setting, read once when a
# run starts and pinned for the whole of it. `claude-sonnet-5` when unset, which
# is what the measured runs and the recorded answers were made on. The only
# other name `engine/pricing.py` has read a price for is `claude-opus-5`; asking
# for anything else stops the run rather than billing against a guess.
KATALYST_MODEL=claude-sonnet-5

# How hard the model tries, for a run meant as a measurement: low, medium, high,
# xhigh or max. Empty by default, and empty means the field is not sent at all —
# the service's own default stands and the request is byte for byte what it was
# before anybody had an opinion. Pinned for a whole run like the model above,
# because changing it between calls would throw away the remembered prefix the
# run reads back at a tenth of the price. `make run-demo EFFORT=medium` sets it
# for one run without editing anything.
KATALYST_EFFORT=

# Where recorded generations are read from, for the keyless replay the first
# screen shows. Empty means the folder that ships with the program. Set it to
# play a recording made somewhere else back through the real route, which is how
# a recording is checked before it is committed.
KATALYST_RECORDINGS=
