{
  /* The build tool's own configuration file, which runs in Node rather than in
     a browser and so needs a different set of built-in types. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    /* `DOM` is here for the end-to-end test: the little functions it hands to
       `page.evaluate` are shipped to the browser and run there, so they need the
       browser's own types even though the file around them runs in Node. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* The build tool's configuration, and the one end-to-end test with the
     settings that start both halves for it. All three run in Node. */
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"]
}
